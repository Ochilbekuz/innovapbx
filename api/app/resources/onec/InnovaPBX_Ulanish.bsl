// =============================================================================
// InnovaPBX_Ulanish
// -----------------------------------------------------------------------------
// Umumiy modul (На сервере = Истина, Клиент = Ложь). Innova PBX REST API
// bilan chiquvchi so'rovlarni amalga oshiradi: chaqiruv boshlash (originate),
// yozuvni yuklab olish, qo'ng'iroqlar ro'yxatini olish.
//
// DIQQAT: 1C platformasi bu serverda yo'q — kod faqat sintaksis jihatidan
// ko'rib chiqilgan. Ishga tushirishdan oldin test bazasida tekshiring.
//
// Sozlamalar manbasi — Metadata-tavsifi.md:
//   Константы.PBXАдресСервераAPI   — masalan "https://pbx.misol.uz"
//   Константы.PBXТаймаутHTTPС      — so'rov kutish vaqti (soniya), sukut 30
//   API kalit (ipk_...) — xavfsiz saqlashdan (ПолучитьAPIКлюч) o'qiladi,
//   kodda QATTIQ YOZILMAGAN.
// =============================================================================

#Область ЭКСПОРТНЫЕ_ФУНКЦИИ

// Innova PBX orqali chiqish qo'ng'irog'ini boshlaydi (originate).
// Avval `ВнутреннийНомер` jiringlaydi, javob bergach `Номер` teriladi.
//
// Parametrlar:
//  Номер           - Строка - tashqi raqam (masalan "+998901234567").
//  ВнутреннийНомер - Строка - ichki raqam (masalan "101").
//  ВнешнийИдентификатор - Строка - ixtiyoriy, o'z tizimingiz identifikatori
//                                  (hodisada call.origin.external_id bo'lib qaytadi).
//
// Qaytaradi:
//  Структура("Успех, ИдентификаторЗапроса, КодОшибки, Сообщение")
Функция ВызватьИзPBX(Номер, ВнутреннийНомер, ВнешнийИдентификатор = "") Экспорт

	Тело = Новый Структура;
	Тело.Вставить("extension", ВнутреннийНомер);
	Тело.Вставить("to", Номер);
	Если ЗначениеЗаполнено(ВнешнийИдентификатор) Тогда
		Тело.Вставить("external_id", ВнешнийИдентификатор);
	КонецЕсли;

	Ответ = ВыполнитьЗапросPBX("POST", "/api/public/v1/calls/originate", Тело);

	Если Ответ.Успех Тогда
		Результат = Новый Структура("Успех, ИдентификаторЗапроса, КодОшибки, Сообщение");
		Результат.Успех = Истина;
		Результат.ИдентификаторЗапроса = ПолучитьСвойствоИзJSON(Ответ.Тело, "request_id");
		Результат.КодОшибки = "";
		Результат.Сообщение = "Qo'ng'iroq boshlandi";
		Возврат Результат;
	КонецЕсли;

	Возврат СформироватьСтруктуруОшибки(Ответ);

КонецФункции

// Qo'ng'iroq yozuvini (audio/wav) ikkilik ma'lumot sifatida yuklab oladi.
//
// Parametrlar:
//  ИдентификаторЗаписи - Строка - webhook payload'dagi call.recordings[].id.
//
// Qaytaradi:
//  Структура("Успех, ДвоичныеДанные, КодОшибки, Сообщение")
Функция ЗаписьРазговора(ИдентификаторЗаписи) Экспорт

	Ответ = ВыполнитьЗапросPBX("GET", "/api/public/v1/recordings/" + ИдентификаторЗаписи, Неопределено);

	Если Ответ.Успех Тогда
		Результат = Новый Структура("Успех, ДвоичныеДанные, КодОшибки, Сообщение");
		Результат.Успех = Истина;
		Результат.ДвоичныеДанные = Ответ.ДвоичноеТело;
		Результат.КодОшибки = "";
		Результат.Сообщение = "Yozuv yuklab olindi";
		Возврат Результат;
	КонецЕсли;

	Возврат СформироватьСтруктуруОшибки(Ответ);

КонецФункции

// Qo'ng'iroqlar ro'yxatini oladi (sahifalash — cursor bo'yicha).
//
// Parametrlar:
//  ДатаС, ДатаПо - Дата (ixtiyoriy, bo'sh bo'lsa cheklovsiz) - UTC.
//  Номер         - Строка (ixtiyoriy) - filtr raqam bo'yicha.
//  Лимит         - Число (ixtiyoriy, sukut 50).
//  Курсор        - Строка (ixtiyoriy) - keyingi sahifa kursori.
//
// Qaytaradi:
//  Структура("Успех, Элементы, СледующийКурсор, КодОшибки, Сообщение")
Функция СписокЗвонков(ДатаС = Неопределено, ДатаПо = Неопределено, Номер = "", Лимит = 50, Курсор = "") Экспорт

	ПараметрыURL = Новый Массив;
	Если ДатаС <> Неопределено Тогда
		ПараметрыURL.Добавить("from=" + ДатаВISO(ДатаС));
	КонецЕсли;
	Если ДатаПо <> Неопределено Тогда
		ПараметрыURL.Добавить("to=" + ДатаВISO(ДатаПо));
	КонецЕсли;
	Если ЗначениеЗаполнено(Номер) Тогда
		ПараметрыURL.Добавить("number=" + КодироватьСтрокуURL(Номер));
	КонецЕсли;
	ПараметрыURL.Добавить("limit=" + Строка(Лимит));
	Если ЗначениеЗаполнено(Курсор) Тогда
		ПараметрыURL.Добавить("cursor=" + КодироватьСтрокуURL(Курсор));
	КонецЕсли;

	ОтносительныйURL = "/api/public/v1/calls";
	Если ПараметрыURL.Количество() > 0 Тогда
		ОтносительныйURL = ОтносительныйURL + "?" + СтрСоединить(ПараметрыURL, "&");
	КонецЕсли;

	Ответ = ВыполнитьЗапросPBX("GET", ОтносительныйURL, Неопределено);

	Если Ответ.Успех Тогда
		Структура = JSONВСтруктуру(Ответ.Тело);
		Элементы = Неопределено;
		Структура.Свойство("items", Элементы);
		СледующийКурсор = Неопределено;
		Структура.Свойство("next_cursor", СледующийКурсор);

		Результат = Новый Структура("Успех, Элементы, СледующийКурсор, КодОшибки, Сообщение");
		Результат.Успех = Истина;
		Результат.Элементы = Элементы;
		Результат.СледующийКурсор = СледующийКурсор;
		Результат.КодОшибки = "";
		Результат.Сообщение = "";
		Возврат Результат;
	КонецЕсли;

	Возврат СформироватьСтруктуруОшибки(Ответ);

КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_HTTP_СОЕДИНЕНИЕ

// Innova PBX REST API'ga bitta so'rov yuboradi (Bearer autentifikatsiya
// bilan) va natijani universal struktura ko'rinishida qaytaradi.
//
// Qaytaradi:
//  Структура("Успех, КодСостояния, Тело, ДвоичноеТело, КодОшибки, Сообщение")
Функция ВыполнитьЗапросPBX(Метод, ОтносительныйURL, Тело)

	Результат = Новый Структура("Успех, КодСостояния, Тело, ДвоичноеТело, КодОшибки, Сообщение",
		Ложь, 0, "", Неопределено, "", "");

	Попытка
		Соединение = СоздатьСоединениеPBX();
	Исключение
		Результат.КодОшибки = "config_error";
		Результат.Сообщение = "PBX manzili yoki API kaliti sozlanmagan: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	АпиКлюч = ПолучитьAPIКлюч();
	Если ПустаяСтрока(АпиКлюч) Тогда
		Результат.КодОшибки = "config_error";
		Результат.Сообщение = "API kaliti sozlanmagan (ipk_...)";
		Возврат Результат;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + АпиКлюч);
	Заголовки.Вставить("Accept", "application/json");

	HTTPЗапрос = Новый HTTPЗапрос(ОтносительныйURL, Заголовки);
	Если Тело <> Неопределено Тогда
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		HTTPЗапрос.УстановитьТелоИзСтроки(СтруктураВJSON(Тело), КодировкаТекста.UTF8, ПорядокБайтовBOM.НеИспользовать);
	КонецЕсли;

	Попытка
		HTTPОтвет = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
	Исключение
		Результат.КодОшибки = "network_error";
		Результат.Сообщение = "PBX bilan ulanishda xato: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = HTTPОтвет.КодСостояния;

	Если HTTPОтвет.КодСостояния >= 200 И HTTPОтвет.КодСостояния < 300 Тогда
		Результат.Успех = Истина;
		// Audio/wav kabi ikkilik javoblar uchun ikkilik ko'rinishini ham saqlaymiz.
		Результат.ДвоичноеТело = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		Попытка
			Результат.Тело = HTTPОтвет.ПолучитьТелоКакСтроку();
		Исключение
			Результат.Тело = ""; // ikkilik javob (audio) — matn sifatida o'qilmaydi, xato emas
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;

	Результат.КодОшибки = КодОшибкиИзHTTPСтатуса(HTTPОтвет.КодСостояния);
	Результат.Сообщение = ТекстОшибкиИзHTTPСтатуса(HTTPОтвет.КодСостояния, HTTPОтвет);
	Возврат Результат;

КонецФункции

Функция СоздатьСоединениеPBX()

	АдресURL = Константы.PBXАдресСервераAPI.Получить();
	Если ПустаяСтрока(АдресURL) Тогда
		ВызватьИсключение "Константы.PBXАдресСервераAPI bo'sh";
	КонецЕсли;

	Таймаут = 30;
	Если Метаданные.Константы.Найти("PBXТаймаутHTTPС") <> Неопределено Тогда
		ЗначениеТаймаута = Константы.PBXТаймаутHTTPС.Получить();
		Если ЗначениеТаймаута > 0 Тогда
			Таймаут = ЗначениеТаймаута;
		КонецЕсли;
	КонецЕсли;

	ИмяСервера = АдресURL;
	Порт = Неопределено;
	ЗащищенноеСоединение = Неопределено;

	Если СтрНачинаетсяС(НРег(АдресURL), "https://") Тогда
		ИмяСервера = Сред(АдресURL, 9);
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	ИначеЕсли СтрНачинаетсяС(НРег(АдресURL), "http://") Тогда
		ИмяСервера = Сред(АдресURL, 8);
	КонецЕсли;

	// "host:port/path" bo'lsa ajratib olish (odatda API manzili path'siz,
	// lekin xavfsizlik uchun tekshiramiz).
	ПозицияСлэш = СтрНайти(ИмяСервера, "/");
	Если ПозицияСлэш > 0 Тогда
		ИмяСервера = Лев(ИмяСервера, ПозицияСлэш - 1);
	КонецЕсли;

	ПозицияДвоеточие = СтрНайти(ИмяСервера, ":");
	Если ПозицияДвоеточие > 0 Тогда
		Порт = Число(Сред(ИмяСервера, ПозицияДвоеточие + 1));
		ИмяСервера = Лев(ИмяСервера, ПозицияДвоеточие - 1);
	КонецЕсли;

	Возврат Новый HTTPСоединение(ИмяСервера, Порт, , , , Таймаут, ЗащищенноеСоединение);

КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ОШИБКИ

// PBX shartnomasidagi aniq xato kodlariga mos tushunarli izoh qaytaradi
// (401 invalid_api_key, 403 insufficient_scope, 422 validatsiya, 429 rate limit).
Функция КодОшибкиИзHTTPСтатуса(КодСостояния)
	Если КодСостояния = 401 Тогда
		Возврат "invalid_api_key";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "insufficient_scope";
	ИначеЕсли КодСостояния = 422 Тогда
		Возврат "validation_error";
	ИначеЕсли КодСостояния = 429 Тогда
		Возврат "rate_limited";
	Иначе
		Возврат "http_" + Строка(КодСостояния);
	КонецЕсли;
КонецФункции

Функция ТекстОшибкиИзHTTPСтатуса(КодСостояния, HTTPОтвет)
	ТекстСервера = "";
	Попытка
		ТекстСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	Исключение
		ТекстСервера = "";
	КонецПопытки;

	Если КодСостояния = 401 Тогда
		Возврат "API kaliti noto'g'ri yoki bekor qilingan (401)";
	ИначеЕсли КодСостояния = 403 Тогда
		Возврат "API kalitida yetarli scope yo'q (403)";
	ИначеЕсли КодСостояния = 422 Тогда
		Возврат "So'rov ma'lumotlari noto'g'ri (422): " + ТекстСервера;
	ИначеЕсли КодСостояния = 429 Тогда
		Возврат "So'rovlar chegarasi oshdi (429), birozdan keyin qayta urinib ko'ring";
	Иначе
		Возврат "PBX xato qaytardi (" + Строка(КодСостояния) + "): " + ТекстСервера;
	КонецЕсли;
КонецФункции

Функция СформироватьСтруктуруОшибки(Ответ)
	Результат = Новый Структура("Успех, ИдентификаторЗапроса, ДвоичныеДанные, Элементы, СледующийКурсор, КодОшибки, Сообщение");
	Результат.Успех = Ложь;
	Результат.ИдентификаторЗапроса = "";
	Результат.ДвоичныеДанные = Неопределено;
	Результат.Элементы = Неопределено;
	Результат.СледующийКурсор = Неопределено;
	Результат.КодОшибки = Ответ.КодОшибки;
	Результат.Сообщение = Ответ.Сообщение;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_НАСТРОЙКИ

// API kalitini (ipk_...) xavfsiz manbadan o'qiydi — doimiylarda emas.
Функция ПолучитьAPIКлюч()
	Попытка
		Возврат БезопасноеХранилищеДанных.ПолучитьЗначение("InnovaPBX_APIКлюч");
	Исключение
		Попытка
			Возврат РегистрыСведений.PBXСекреты.ПолучитьСекрет("APIКлюч");
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_JSON_И_СТРОКИ

Функция JSONВСтруктуру(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Ложь);
КонецФункции

Функция СтруктураВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПолучитьСвойствоИзJSON(ТекстJSON, Имя)
	Если ПустаяСтрока(ТекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	Структура = JSONВСтруктуру(ТекстJSON);
	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ДатаВISO(Дата)
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss'Z'");
КонецФункции

Функция КодироватьСтрокуURL(Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти
