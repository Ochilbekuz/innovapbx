// =============================================================================
// InnovaPBX_HTTPServis
// -----------------------------------------------------------------------------
// HTTP-servis moduli. Innova PBX'dan keladigan webhook hodisalarini qabul
// qiladi: imzoni (HMAC-SHA256) tekshiradi, vaqt tamg'asini tekshiradi,
// X-Innova-Delivery bo'yicha idempotentlikni ta'minlaydi va hodisani
// РегистрСведений.PBXСобытияЗвонков ga yozadi.
//
// DIQQAT (ub-mode — Boundary Discipline): bu server 1C:Enterprise
// platformasi O'RNATILMAGAN muhitda tayyorlangan. Kod faqat SINTAKSIS
// jihatidan tekshirilgan (1C:ЕDT/Конфигуратор grammatikasi bo'yicha qo'lda
// ko'rib chiqilgan), real platformada ishga tushirib SINALMAGAN. Ishga
// tushirishdan oldin test konfiguratsiyasida albatta tekshiring.
//
// Talab qilinadigan metadata — Metadata-tavsifi.md faylida.
// HTTP-servis: Nomi = "InnovaPBX", URL shablon ildizi = "innova",
//   Shablon "event", metod POST → shu modul, protsedura ОбработкаСобытия.
// =============================================================================

#Область ОБЩИЕ_ПАРАМЕТРЫ

// Imzodagi "t=...,v1=..." formatidagi ruxsat etilgan vaqt og'ishi (soniya).
// Amalda Константы.PBXДопустимоеОтклонениеВременнойМеткиС dan o'qiladi,
// agar konstanta hali yaratilmagan bo'lsa — sukut qiymat ishlatiladi.
Функция ОтклонениеВременнойМеткиПоУмолчанию()
	Возврат 300; // ±300 s — shartnomada belgilangan qiymat
КонецФункции

#КонецОбласти

#Область HTTP_СЕРВИС_ТОЧКА_ВХОДА

// HTTP-servis metodi: POST /innova/event
// Innova PBX'dan kelgan bitta webhook hodisasini qabul qiladi.
//
// Parametrlar:
//  Запрос - HTTPСервисЗапрос - platforma tomonidan avtomatik uzatiladi.
//
// Qaytaradi:
//  HTTPСервисОтвет - 200 (qabul qilindi/allaqachon qabul qilingan),
//                     400 (noto'g'ri so'rov), 401 (imzo/vaqt noto'g'ri).
Функция ОбработкаСобытия(Запрос) Экспорт

	Попытка
		ИдентификаторДоставки = ЗаголовокЗапроса(Запрос, "X-Innova-Delivery");
		ТипСобытия            = ЗаголовокЗапроса(Запрос, "X-Innova-Event");
		ЗаголовокПодписи      = ЗаголовокЗапроса(Запрос, "X-Innova-Signature");

		Если ПустаяСтрока(ИдентификаторДоставки)
			Или ПустаяСтрока(ТипСобытия)
			Или ПустаяСтрока(ЗаголовокПодписи) Тогда
			Возврат СформироватьОтвет(400, "bad_request", "Majburiy sarlavhalar yo'q: X-Innova-Delivery/X-Innova-Event/X-Innova-Signature");
		КонецЕсли;

		ТелоДвоичные = Запрос.ПолучитьТелоКакДвоичныеДанные();

		// --- 1) Imzoni ajratib olish: "t=<unix>,v1=<hex>" ---
		ВременнаяМетка = Неопределено;
		ПереданнаяПодпись = "";
		Если Не РазобратьЗаголовокПодписи(ЗаголовокПодписи, ВременнаяМетка, ПереданнаяПодпись) Тогда
			Возврат СформироватьОтвет(401, "invalid_signature", "X-Innova-Signature formati noto'g'ri");
		КонецЕсли;

		// --- 2) Vaqt tamg'asi tekshiruvi (replay-hujumdan himoya) ---
		ДопустимоеОтклонениеС = ОтклонениеВременнойМеткиПоУмолчанию();
		Если Метаданные.Константы.Найти("PBXДопустимоеОтклонениеВременнойМеткиС") <> Неопределено Тогда
			Попытка
				ДопустимоеОтклонениеС = Константы.PBXДопустимоеОтклонениеВременнойМеткиС.Получить();
				Если ДопустимоеОтклонениеС = 0 Тогда
					ДопустимоеОтклонениеС = ОтклонениеВременнойМеткиПоУмолчанию();
				КонецЕсли;
			Исключение
				ДопустимоеОтклонениеС = ОтклонениеВременнойМеткиПоУмолчанию();
			КонецПопытки;
		КонецЕсли;

		ТекущаяМетка = ТекущаяUnixВременнаяМетка();
		Если Abs(ТекущаяМетка - ВременнаяМетка) > ДопустимоеОтклонениеС Тогда
			Возврат СформироватьОтвет(401, "stale_timestamp", "Vaqt tamg'asi ruxsat etilgan oynadan tashqarida");
		КонецЕсли;

		// --- 3) HMAC-SHA256 ni qayta hisoblash va solishtirish ---
		Секрет = ПолучитьWebhookСекрет();
		Если ПустаяСтрока(Секрет) Тогда
			// Sozlanmagan - xavfsizlik uchun har doim rad etamiz, jim o'tkazib yubormaymiz.
			Возврат СформироватьОтвет(401, "not_configured", "Webhook secret sozlanmagan");
		КонецЕсли;

		КутилганПодпись = HMACSHA256Hex(Секрет, ВременнаяМеткаВСтроку(ВременнаяМетка), ТелоДвоичные);

		Если Не ПодписиСовпадают(КутилганПодпись, ПереданнаяПодпись) Тогда
			Возврат СформироватьОтвет(401, "invalid_signature", "HMAC imzo mos kelmadi");
		КонецЕсли;

		// --- 4) Idempotentlik: X-Innova-Delivery oldin qabul qilinganmi? ---
		Если ДоставкаУжеОбработана(ИдентификаторДоставки) Тогда
			Возврат СформироватьОтвет(200, "ok", "Takroriy yetkazish, qayta ishlanmadi (idempotent)");
		КонецЕсли;

		// --- 5) JSON tanani ajratish va hodisani registrga yozish ---
		ТелоСтрока = Запрос.ПолучитьТелоКакСтроку();
		ТелоСтруктура = JSONВСтруктуру(ТелоСтрока);

		ЗаписатьСобытиеВРегистр(ТипСобытия, ТелоСтруктура, ТелоСтрока);
		ЗафиксироватьДоставку(ИдентификаторДоставки, ТипСобытия, 200);

		Возврат СформироватьОтвет(200, "ok", "Qabul qilindi");

	Исключение
		// Fix Root Causes: xatoni yutib yubormaymiz — lekin tashqariga texnik
		// tafsilot chiqarmaymiz (xavfsizlik), faqat 400 bilan umumiy xabar.
		ЗаписьЖурналаРегистрации("InnovaPBX.Webhook", УровеньЖурналаРегистрации.Ошибка,,,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат СформироватьОтвет(400, "internal_error", "So'rovni qayta ishlashda ichki xato");
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_HTTP

Функция СформироватьОтвет(КодСостояния, Код, Сообщение)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Структура = Новый Структура("ok, code, message", КодСостояния < 300, Код, Сообщение);
	Ответ.УстановитьТелоИзСтроки(СтруктураВJSON(Структура));
	Возврат Ответ;
КонецФункции

// "t=1700000000,v1=abcdef..." ni ikki qiymatga ajratadi.
Функция РазобратьЗаголовокПодписи(Заголовок, ВременнаяМетка, Подпись)

	Части = СтрРазделить(Заголовок, ",", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	НайденВремя = Ложь;
	НайденаПодпись = Ложь;

	Для Каждого Часть Из Части Цикл
		ПозицияРавно = СтрНайти(Часть, "=");
		Если ПозицияРавно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Лев(Часть, ПозицияРавно - 1));
		Значение = СокрЛП(Сред(Часть, ПозицияРавно + 1));
		Если Ключ = "t" Тогда
			Если Не ЗначениеЗаполнено(Значение) Или Не СтрокаЦелоеЧисло(Значение) Тогда
				Возврат Ложь;
			КонецЕсли;
			ВременнаяМетка = Число(Значение);
			НайденВремя = Истина;
		ИначеЕсли Ключ = "v1" Тогда
			Подпись = НРег(Значение);
			НайденаПодпись = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат НайденВремя И НайденаПодпись;

КонецФункции

Функция СтрокаЦелоеЧисло(Значение)
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Значение) > 0;
КонецФункции

Функция ВременнаяМеткаВСтроку(ВременнаяМетка)
	Возврат Строка(Цел(ВременнаяМетка));
КонецФункции

// Doimiy vaqtli taqqoslash (timing-attack'ni kamaytirish uchun) — ikki
// hex-satrni UZUNLIGI va TARKIBI mos kelgan-kelmaganini bitta o'tishda
// tekshiradi, lekin birinchi noto'g'ri belgida darhol to'xtamaydi.
Функция ПодписиСовпадают(Подпись1, Подпись2)
	Если СтрДлина(Подпись1) <> СтрДлина(Подпись2) Тогда
		Возврат Ложь;
	КонецЕсли;
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Подпись1) Цикл
		Если Сред(Подпись1, Индекс, 1) <> Сред(Подпись2, Индекс, 1) Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат = 0;
КонецФункции

Функция ТекущаяUnixВременнаяМетка()
	Возврат ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1, 0, 0, 0);
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_ЗАГОЛОВКИ

// HTTP sarlavha nomlari registrga sezgir emas (proksi/HTTP2 ularni kichik harfga o'tkazishi mumkin),
// Запрос.Заголовки esa Соответствие — shuning uchun nom НРег bilan solishtiriladi.
Функция ЗаголовокЗапроса(Запрос, Имя)
	ИмяНРег = НРег(Имя);
	Для Каждого Элемент Из Запрос.Заголовки Цикл
		Если НРег(Элемент.Ключ) = ИмяНРег Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_HMAC_SHA256
//
// 1C:Enterprise 8.3 ichki "ХешированиеДанных" obyekti HMAC rejimini
// BEVOSITA qo'llamaydi (faqat sodda xeshlash: MD5/SHA1/SHA256/...).
// Shuning uchun HMAC-SHA256 RFC 2104 / FIPS 198 bo'yicha QO'LDA
// amalga oshirilgan: ipad/opad, blok hajmi 64 bayt, xesh chiqishi 32 bayt.
// Algoritm Python'da RFC 4231 test vektorlari bilan tekshirilgan
// (hisobotda keltirilgan) — mantiq bu yerdagi kodga aynan mos keladi.
//

// HMAC-SHA256(Секрет, ВременнаяМетка + "." + ТелоДвоичные) ni hisoblaydi
// va kichik harflardagi hex satr sifatida qaytaradi.
Функция HMACSHA256Hex(Секрет, ВременнаяМеткаСтрока, ТелоДвоичные)

	РазмерБлока = 64; // SHA-256 uchun blok hajmi (bayt)

	КлючДвоичные = ПолучитьДвоичныеДанныеИзСтроки(Секрет, КодировкаТекста.UTF8, Ложь);
	Если КлючДвоичные.Размер() > РазмерБлока Тогда
		КлючДвоичные = SHA256(КлючДвоичные);
	КонецЕсли;
	Ключ = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(КлючДвоичные);

	// Kalit 64 baytgacha nollar bilan to'ldiriladi va 0x36 (54) / 0x5C (92) bilan XOR qilinadi.
	ИПад = Новый БуферДвоичныхДанных(РазмерБлока);
	ОПад = Новый БуферДвоичныхДанных(РазмерБлока);
	Для Индекс = 0 По РазмерБлока - 1 Цикл
		Байт = ?(Индекс < Ключ.Размер, Ключ[Индекс], 0);
		ИПад[Индекс] = ПобитовоеИсключительноеИли(Байт, 54);
		ОПад[Индекс] = ПобитовоеИсключительноеИли(Байт, 92);
	КонецЦикла;

	Префикс = ПолучитьДвоичныеДанныеИзСтроки(ВременнаяМеткаСтрока + ".", КодировкаТекста.UTF8, Ложь);
	ВнутреннийХеш = SHA256(Соединить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ИПад), Префикс, ТелоДвоичные));
	Итог = SHA256(Соединить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(ОПад), ВнутреннийХеш));

	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Итог));

КонецФункции

Функция SHA256(ДвоичныеДанные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ДвоичныеДанные);
	Возврат Хеширование.ХешСумма; // ДвоичныеДанные, 32 bayt
КонецФункции

// ДвоичныеДанные bo'laklarini ketma-ket birlashtiradi (platforma 8.3.11+).
Функция Соединить(Часть1, Часть2, Часть3 = Неопределено)
	Части = Новый Массив;
	Части.Добавить(Часть1);
	Части.Добавить(Часть2);
	Если Часть3 <> Неопределено Тогда
		Части.Добавить(Часть3);
	КонецЕсли;
	Возврат СоединитьДвоичныеДанные(Части);
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_НАСТРОЙКИ

// Webhook secret'ni xavfsiz manbadan o'qiydi. BSP (Библиотека стандартных
// подсистем) o'rnatilgan bo'lsa — БезопасноеХранилищеДанных umumiy
// modulidan foydalaning. BSP yo'q bo'lsa — RegistrSvedeniy.PBXСекреты
// (faqat администратор rolига ochiq) dan o'qing. Hech qachon kodga
// qattiq yozilgan qiymat ishlatmang.
Функция ПолучитьWebhookСекрет()

	Попытка
		// Variant A: BSP mavjud bo'lsa.
		Возврат БезопасноеХранилищеДанных.ПолучитьЗначение("InnovaPBX_WebhookSecret");
	Исключение
		// Variant B: BSP yo'q — alohida himoyalangan registr.
		Попытка
			Возврат РегистрыСведений.PBXСекреты.ПолучитьСекрет("WebhookSecret");
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_РЕГИСТРЫ

Функция ДоставкаУжеОбработана(ИдентификаторДоставки)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Доставки.ИдентификаторДоставки КАК Идентификатор
		|ИЗ
		|	РегистрСведений.PBXВходящиеДоставки КАК Доставки
		|ГДЕ
		|	Доставки.ИдентификаторДоставки = &ИдентификаторДоставки";
	Запрос.УстановитьПараметр("ИдентификаторДоставки", ИдентификаторДоставки);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

Процедура ЗафиксироватьДоставку(ИдентификаторДоставки, ТипСобытия, КодОтвета)
	Набор = РегистрыСведений.PBXВходящиеДоставки.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторДоставки.Установить(ИдентификаторДоставки);
	Запись = Набор.Добавить();
	Запись.ИдентификаторДоставки = ИдентификаторДоставки;
	Запись.ДатаПолучения = ТекущаяДата();
	Запись.ТипСобытия = ТипСобытия;
	Запись.КодОтвета = КодОтвета;
	Набор.Записать(Истина); // Истина — доставка измерениси bo'yicha almashtirish (upsert)
КонецПроцедуры

Процедура ЗаписатьСобытиеВРегистр(ТипСобытия, ТелоСтруктура, ТелоСтрокаДляАудита)

	Звонок = Неопределено;
	ТелоСтруктура.Свойство("call", Звонок);

	// test.ping kabi hodisalarda "call" bo'lmasligi mumkin — faqat audit yetarli.
	Если Звонок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторЗвонка = ПолучитьСвойствоСтрока(Звонок, "id");
	Если ПустаяСтрока(ИдентификаторЗвонка) Тогда
		Возврат; // to'liqsiz payload — yozilmaydi, lekin 2xx qaytariladi (ub-mode: silent dropdan ko'ra aniq shart)
	КонецЕсли;

	Очередь = Неопределено;
	Звонок.Свойство("queue", Очередь);

	Набор = РегистрыСведений.PBXСобытияЗвонков.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗвонка.Установить(ИдентификаторЗвонка);
	Набор.Отбор.ТипСобытия.Установить(ТипСобытия);
	Запись = Набор.Добавить();
	Запись.Период                = ТекущаяДата();
	Запись.ИдентификаторЗвонка   = ИдентификаторЗвонка;
	Запись.ТипСобытия            = ТипСобытия;
	Запись.Направление           = ПолучитьСвойствоСтрока(Звонок, "direction");
	Запись.От                    = ПолучитьСвойствоСтрока(Звонок, "from");
	Запись.Кому                  = ПолучитьСвойствоСтрока(Звонок, "to");
	Запись.ВнутреннийНомер       = ПолучитьСвойствоСтрока(Звонок, "extension");
	Если Очередь <> Неопределено Тогда
		Запись.ОчередьИдентификатор = ПолучитьСвойствоСтрока(Очередь, "id");
		Запись.ОчередьНазвание      = ПолучитьСвойствоСтрока(Очередь, "name");
	КонецЕсли;
	Запись.Статус                = ПолучитьСвойствоСтрока(Звонок, "status");
	Запись.ДлительностьС         = ПолучитьСвойствоЧисло(Звонок, "duration_s");
	Запись.BillsecС              = ПолучитьСвойствоЧисло(Звонок, "billsec");
	Запись.ОтветившийВнутренний  = ПолучитьСвойствоСтрока(Звонок, "answered_by");
	Запись.ТелоJSON              = ТелоСтрокаДляАудита;
	Набор.Записать(Истина);

КонецПроцедуры

Функция ПолучитьСвойствоСтрока(Структура, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПолучитьСвойствоЧисло(Структура, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") И Структура.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Попытка
			Возврат Число(Значение);
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область СЛУЖЕБНЫЕ_JSON

Функция JSONВСтруктуру(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Возврат ПрочитатьJSON(Чтение, Ложь);
КонецФункции

Функция СтруктураВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
