# Innova PBX — muhit namunasi. Haqiqiy sirlarni `.env` fayliga yozing
# (`.env` git'ga COMMIT QILINMAYDI, chmod 600).
#
# Tasodifiy sir yaratish: openssl rand -base64 32

# --- Postgres ---
POSTGRES_USER=innova
POSTGRES_PASSWORD=change-me
POSTGRES_DB=innova

# --- API (pgcrypto kaliti — Asterisk realtime view bilan bir xil bo'lishi SHART) ---
INNOVA_DB_KEY=change-me
SECRET_KEY=change-me

# --- AMI (Asterisk Manager Interface) ---
AMI_USERNAME=innova
AMI_PASSWORD=change-me

# --- API portI (faqat 127.0.0.1 ga publish qilinadi) ---
API_HOST_PORT=8710

# --- Veb (SPA + /api/ + /sip-ws WebRTC), M3a — sukut faqat 127.0.0.1 ga publish qilinadi ---
# Appliance (ISO) LAN'dan ochadi: WEB_BIND=0.0.0.0, WEB_HOST_PORT=80.
WEB_BIND=127.0.0.1
WEB_HOST_PORT=8711
# 1.0.4: HTTPS (softfon mikrofon ruxsati uchun) — sukut 8712, appliance'da 443.
WEB_HTTPS_PORT=8712
# Softfon WS ticket muddati (sekund), ixtiyoriy — sukut 600
# SOFTPHONE_TICKET_TTL_S=600

# --- 1.0.4: veb HTTPS sertifikat SAN'i (install.sh/innova-start.sh avtomatik to'ldiradi) ---
# WEB_TLS_HOSTNAME=innova-pbx
# WEB_TLS_SAN_IPS=192.168.1.10,10.0.0.5

# --- 1.0.4: o'rnatish kodi (install.sh generatsiya qilib ko'rsatadi; bo'sh = tekshiruv o'chiq) ---
# SETUP_CODE=

# m0-proof.sh test admin paroli
PROOF_ADMIN_PASSWORD=
